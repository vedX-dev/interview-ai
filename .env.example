# Required: PostgreSQL Database URL with pgvector support
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interviewai"

# Required: Clerk Authentication Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Optional: LLM Providers (At least one recommended; fallback routing layer switches automatically)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional: Voice Synthesis (Sarvam AI Bulbul v3 proxy)
SARVAM_API_KEY=

# Optional: Upstash Redis (For TTS Caching & Rate Limiting, falls back to in-memory if absent)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
